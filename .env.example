# Convex deployment URL (set by init_app_project tool or npx convex dev)
VITE_CONVEX_URL=

# For local development with npx convex dev
# CONVEX_DEPLOY_KEY=

# Auth private key (RSA 2048, generated automatically)
# AUTH_PRIVATE_KEY=

# Set to "true" on preview/dev deployments to enable the @test.local credentials provider
# IS_PREVIEW=

# Shared secret used to verify SSO tokens signed by the Central Manager
# SSO_SHARED_SECRET=

# Self-hosted SMTP for email verification / password reset
# SMTP_HOST=
# SMTP_PORT=587          # 587 = STARTTLS, 465 = implicit TLS
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# Admin agent secret for plugin upload / metadata / changelog ops
# ADMIN_PROJECT_SECRET=
